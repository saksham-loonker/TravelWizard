{
  "root": true,
  "extends": ["next/core-web-vitals"],
  "ignorePatterns": [
    "node_modules/",
    ".next/",
    "dist/",
    "coverage/",
    "vendor/swiftbrowse/",
    "swiftbrowse/"
  ],
  "settings": {
    "next": {
      "rootDir": ["apps/web/"]
    },
    "react": {
      "version": "18.3"
    }
  },
  "rules": {
    "@next/next/no-html-link-for-pages": "off",
    "no-console": ["warn", { "allow": ["warn", "error"] }]
  }
}
